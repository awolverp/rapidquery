@final
class Oracle(SqlDialect): ...

@final
class PostgreSql(SqlDialect): ...

@final
class Redshift(SqlDialect): ...

@final
class Snowflake(SqlDialect): ...

@final
class Spark(SqlDialect): ...

@final
class Sqlite(SqlDialect): ...

@final
class Teradata(SqlDialect): ...
