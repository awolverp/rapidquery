import typing
from collections.abc import Iterable, Iterator, Sequence
from typing import Self, final, overload

from rapidquery.data_type import DataType, Serializer
from rapidquery.dialect import SqlDialect

class Expr:
    """
    Abstract SQL expression.

    Concrete nodes are frozen subclasses (``Ident``, ``Value``, ``Func``,
    ``Binary``, …). This base class cannot be instantiated.

    Future methods (``to_sql``, ``eq``, ``like``, ``between``, ``in_``,
    ``is_null``, ``cast``, ``case``, ``custom``, arithmetic/logic) will live
    here so every subclass inherits them. Prefer named methods over v0-style
    dunders that return ``Expr``.
    """

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...

@final
class Unquote:
    def __new__(cls, name: str, /) -> Self: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...

@final
class Asterisk:
    def __new__(cls) -> Self: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...

@final
class Ident(Expr):
    def __new__(
        cls, *parts: str | Unquote | Ident | Asterisk | type[Asterisk]
    ) -> Self: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> str | Unquote | Asterisk: ...
    @overload
    def __getitem__(self, index: slice) -> Ident: ...
    def to_list(self) -> Sequence[str | Unquote | Asterisk]: ...
    def to_sql(self, dialect: type[SqlDialect] | SqlDialect) -> str: ...

_T = typing.TypeVar("_T")

@final
class Value(Expr, typing.Generic[_T]):
    @overload
    def __new__(cls, object: _T, /) -> typing.Self: ...
    @overload
    def __new__(
        cls,
        object: _T,
        serializer: Serializer[_T] | DataType[_T] | None = None,
        /,
    ) -> typing.Self: ...
    @property
    def object(self) -> _T: ...
    @property
    def serializer(self) -> Serializer[_T]: ...
    def to_sql(self, dialect: type[SqlDialect] | SqlDialect) -> str: ...

@final
class Function(Expr):
    def __new__(
        cls,
        name: str | Ident | Unquote,
        *args: object,
        distinct: bool | None = None,
        filter: object | None = None,
    ) -> Self: ...
    @property
    def name(self) -> Ident: ...
    @property
    def args(self) -> tuple[Expr, ...] | None: ...
    @property
    def filter(self) -> Expr | None: ...

@final
class TupleExpr(Expr):
    def __new__(cls, *items: object) -> Self: ...
    @property
    def items(self) -> tuple[Expr, ...]: ...

@final
class UnaryExpr(Expr):
    def __new__(cls, op: str, expr: object, /) -> Self: ...
    @property
    def op(self) -> str: ...
    @property
    def expr(self) -> Expr: ...

@final
class BinaryExpr(Expr):
    def __new__(cls, left: object, op: str, right: object, /) -> Self: ...
    @property
    def left(self) -> Expr: ...
    @property
    def op(self) -> str: ...
    @property
    def right(self) -> Expr: ...

@final
class IsExpr(Expr):
    def __new__(cls, expr: object, kind: str, *, negated: bool = False) -> Self: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def kind(self) -> str: ...
    @property
    def negated(self) -> bool: ...

@final
class IsDistinctFromExpr(Expr):
    def __new__(cls, left: object, right: object, *, negated: bool = False) -> Self: ...
    @property
    def left(self) -> Expr: ...
    @property
    def right(self) -> Expr: ...
    @property
    def negated(self) -> bool: ...

@final
class InListExpr(Expr):
    def __new__(
        cls, expr: object, list: Iterable[object], *, negated: bool = False
    ) -> Self: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def list(self) -> tuple[Expr, ...]: ...
    @property
    def negated(self) -> bool: ...

@final
class BetweenExpr(Expr):
    def __new__(
        cls,
        expr: object,
        low: object,
        high: object,
        *,
        negated: bool = False,
    ) -> Self: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def low(self) -> Expr: ...
    @property
    def high(self) -> Expr: ...
    @property
    def negated(self) -> bool: ...

@final
class LikeExpr(Expr):
    def __new__(
        cls,
        expr: object,
        pattern: object,
        *,
        kind: str = "LIKE",
        negated: bool = False,
        escape: str | None = None,
    ) -> Self: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def pattern(self) -> Expr: ...
    @property
    def kind(self) -> str: ...
    @property
    def negated(self) -> bool: ...
    @property
    def escape(self) -> str | None: ...

@final
class CastExpr(Expr):
    def __new__(cls, expr: object, data_type: DataType, /) -> Self: ...
    @property
    def expr(self) -> Expr: ...
    @property
    def data_type(self) -> DataType: ...

@final
class CaseExpr(Expr):
    def __new__(
        cls,
        when_then: Iterable[tuple[object, object]],
        *,
        operand: object | None = None,
        else_: object | None = None,
    ) -> Self: ...
    @property
    def operand(self) -> Expr | None: ...
    @property
    def when_then(self) -> tuple[tuple[Expr, Expr], ...]: ...
    @property
    def else_(self) -> Expr | None: ...

@final
class CustomExpr(Expr):
    def __new__(cls, sql: str, *args: object) -> Self: ...
    @property
    def sql(self) -> str: ...
    @property
    def args(self) -> tuple[Expr, ...]: ...
