"""
SQL dialects and the integer flags that configure one.
"""

import typing

@typing.final
class AggregateConfig:
    def __new__(cls, *, null_treatment: int = ..., function_filter: int = ...) -> typing.Self: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    @property
    def null_treatment(self) -> int: ...
    @property
    def function_filter(self) -> int: ...

@typing.final
class BitwiseConfig:
    def __new__(cls, *, operations: int = 0, syntax: int = ..., xor: int = ...) -> typing.Self: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    @property
    def null_treatment(self) -> int: ...
    @property
    def function_filter(self) -> int: ...
